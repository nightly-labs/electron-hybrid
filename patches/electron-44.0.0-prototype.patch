+
+void ElectronAuthenticatorRequestClientDelegate::ConfigureDiscoveries(
+    const url::Origin& origin,
+    const std::string& rp_id,
+    RequestSource request_source,
+    device::FidoRequestType request_type,
+    std::optional<device::ResidentKeyRequirement> resident_key_requirement,
+    device::UserVerificationRequirement user_verification_requirement,
+    bool cmtg_key_requested,
+    std::optional<std::string_view> user_name,
+    bool is_enclave_authenticator_available,
+    device::FidoDiscoveryFactory* fido_discovery_factory) {
+  if (!fido_discovery_factory || ui_presentation_ != UIPresentation::kModal) {
+    return;
+  }
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(render_frame_host_id_);
+  if (!rfh) {
+    return;
+  }
+  content::BrowserContext* browser_context = rfh->GetBrowserContext();
+  if (!browser_context) {
+    return;
+  }
+  // Same concept as Chrome: fresh QR key, real cablev2 payload, same key
+  // given to the discovery factory. Debug log only; never log key material.
+  std::array<uint8_t, device::cablev2::kQRKeySize> qr_generator_key;
+  crypto::RandBytes(qr_generator_key);
+  const std::string qr_string =
+      device::cablev2::qr::Encode(qr_generator_key, request_type);
+  if (qr_string.rfind("FIDO:/", 0) != 0) {
+    return;
+  }
+  fido_discovery_factory->set_cable_data(request_type, qr_generator_key);
+  fido_discovery_factory->set_cable_event_callback(base::BindRepeating(
+      &ElectronAuthenticatorRequestClientDelegate::OnCableEvent,
+      weak_factory_.GetWeakPtr()));
+  // Electron equivalent of Chrome SystemNetworkContextManager wiring: use the
+  // requesting WebContents BrowserContext default StoragePartition context so
+  // the encrypted caBLE tunnel has network access. No Chrome Profile object.
+  // NOTE: BindRepeating rejects capturing lambdas, so the context is passed
+  // as a bound argument to a non-capturing lambda.
+  fido_discovery_factory->set_network_context_factory(base::BindRepeating(
+      [](content::BrowserContext* context) -> network::mojom::NetworkContext* {
+        content::StoragePartition* partition =
+            context->GetDefaultStoragePartition();
+        return partition ? partition->GetNetworkContext() : nullptr;
+      },
+      browser_context));
+  pending_hybrid_qr_ = qr_string;
+}
+
+void ElectronAuthenticatorRequestClientDelegate::SetUIPresentation(
+    UIPresentation ui_presentation) {
+  ui_presentation_ = ui_presentation;
+}
+
+void ElectronAuthenticatorRequestClientDelegate::
+    OnTransportAvailabilityEnumerated(
+        device::FidoRequestHandlerBase::TransportAvailabilityInfo data) {
+  if (pending_hybrid_qr_.empty()) {
+    return;
+  }
+  if (!data.available_transports.contains(
+          device::FidoTransportProtocol::kHybrid)) {
+    ClearHybridState();
+    return;
+  }
+  auto weak_this = weak_factory_.GetWeakPtr();
+  EmitHybridEvent("webauthn-hybrid-qr", "qr");
+  if (!weak_this || pending_hybrid_qr_.empty()) {
+    return;
+  }
+  // Request the macOS permission only once discovery has enumerated its
+  // adapter. Calling this earlier dereferences an uninitialized BLE manager.
+  if (data.ble_status == device::FidoRequestHandlerBase::BleStatus::
+                             kPendingPermissionRequest &&
+      request_ble_permission_callback_) {
+    EmitHybridEvent("webauthn-hybrid-status", "bluetooth-permission-requested");
+    if (!weak_this || pending_hybrid_qr_.empty()) {
+      return;
+    }
+    request_ble_permission_callback_.Run(
+        base::BindOnce(&ElectronAuthenticatorRequestClientDelegate::
+                           BluetoothAdapterStatusChanged,
+                       weak_factory_.GetWeakPtr()));
+    return;
+  }
+  BluetoothAdapterStatusChanged(data.ble_status);
+}
+
+void ElectronAuthenticatorRequestClientDelegate::BluetoothAdapterStatusChanged(
+    device::FidoRequestHandlerBase::BleStatus status) {
+  if (pending_hybrid_qr_.empty()) {
+    return;
+  }
+  using BleStatus = device::FidoRequestHandlerBase::BleStatus;
+  switch (status) {
+    case BleStatus::kOn:
+      EmitHybridEvent("webauthn-hybrid-status", "bluetooth-on");
+      break;
+    case BleStatus::kOff:
+      EmitHybridEvent("webauthn-hybrid-status", "bluetooth-off");
+      break;
+    case BleStatus::kPermissionDenied:
+      EmitHybridEvent("webauthn-hybrid-status", "bluetooth-permission-denied");
+      break;
+    case BleStatus::kPendingPermissionRequest:
+      break;
+  }
 }
 
