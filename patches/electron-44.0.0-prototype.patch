+void ElectronAuthenticatorRequestClientDelegate::EmitHybridEvent(
+    const char* event_name,
+    const char* status) {
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(render_frame_host_id_);
+  content::WebContents* web_contents =
+      rfh ? content::WebContents::FromRenderFrameHost(rfh) : nullptr;
+  gin::WeakCell<api::Session>* session =
+      web_contents
+          ? api::Session::FromBrowserContext(web_contents->GetBrowserContext())
+          : nullptr;
+  if (!session || !session->Get()) {
+    return;
+  }
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  gin::DataObjectBuilder details_builder(isolate);
+  details_builder.Set("relyingPartyId", relying_party_id_)
+      .Set("status", std::string(status))
+      .Set("frame", rfh);
+  if (std::string_view(event_name) == "webauthn-hybrid-qr") {
+    details_builder.Set("qr", pending_hybrid_qr_);
+  }
+  v8::Local<v8::Object> details = details_builder.Build();
+  v8::Local<v8::Object> session_wrapper;
+  if (!session->Get()->GetWrapper(isolate).ToLocal(&session_wrapper)) {
+    return;
+  }
+  v8::Local<v8::Object> event_object = gin_helper::internal::Event::New(isolate)
+                                           ->GetWrapper(isolate)
+                                           .ToLocalChecked();
+  if (std::string_view(event_name) == "webauthn-hybrid-qr") {
+    gin_helper::EmitEvent(
+        isolate, session_wrapper, event_name, event_object, details,
+        base::BindRepeating(&ElectronAuthenticatorRequestClientDelegate::
+                                CancelPendingAccountSelection,
+                            weak_factory_.GetWeakPtr()));
+  } else {
+    gin_helper::EmitEvent(isolate, session_wrapper, event_name, event_object,
+                          details);
+  }
+}
+
+void ElectronAuthenticatorRequestClientDelegate::ClearHybridState() {
+  if (pending_hybrid_qr_.empty()) {
+    return;
+  }
+  pending_hybrid_qr_.clear();
+  EmitHybridEvent("webauthn-hybrid-status", "closed");
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnCableEvent(
+    device::cablev2::Event event) {
+  switch (event) {
+    case device::cablev2::Event::kPhoneConnected:
+      EmitHybridEvent("webauthn-hybrid-status", "phone-connected");
+      break;
+    case device::cablev2::Event::kBLEAdvertReceived:
+      EmitHybridEvent("webauthn-hybrid-status", "ble-advert-received");
+      break;
+    case device::cablev2::Event::kReady:
+      EmitHybridEvent("webauthn-hybrid-status", "ready");
+      break;
+  }
+}
+
 void ElectronAuthenticatorRequestClientDelegate::
     CancelPendingAccountSelection() {
   pending_responses_.clear();
   select_account_callback_.Reset();
+  ClearHybridState();
   if (cancel_callback_) {
     std::move(cancel_callback_).Run();
   }
