+bool ElectronAuthenticatorRequestClientDelegate::EmitHybridEvent(
+    const char* event_name,
+    const char* status) {
+  base::RepeatingClosure cancel;
+  if (std::string_view(event_name) == "webauthn-hybrid-qr") {
+    cancel = base::BindRepeating(
+        &ElectronAuthenticatorRequestClientDelegate::CancelHybridRequest,
+        weak_factory_.GetWeakPtr(), hybrid_request_id_);
+  }
+  const std::string qr = cancel ? pending_hybrid_qr_ : std::string();
+  return EmitHybridSessionEvent(hybrid_browser_context_, render_frame_host_id_,
+                                relying_party_id_, hybrid_origin_,
+                                hybrid_request_id_, event_name, status, qr,
+                                std::move(cancel));
+}
+
+void ElectronAuthenticatorRequestClientDelegate::CancelHybridRequest(
+    const std::string& request_id) {
+  if (!pending_hybrid_qr_.empty() && request_id == hybrid_request_id_) {
+    CancelPendingAccountSelection();
+  }
+}
+
+void ElectronAuthenticatorRequestClientDelegate::ClearHybridState() {
+  if (pending_hybrid_qr_.empty()) {
+    return;
+  }
+  pending_hybrid_qr_.clear();
+  weak_factory_.InvalidateWeakPtrs();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<ElectronBrowserContext> context,
+             content::GlobalRenderFrameHostId frame_id, std::string rp_id,
+             std::string origin, std::string request_id) {
+            EmitHybridSessionEvent(context, frame_id, rp_id, origin, request_id,
+                                   "webauthn-hybrid-status", "closed",
+                                   std::string(), base::RepeatingClosure());
+          },
+          hybrid_browser_context_, render_frame_host_id_, relying_party_id_,
+          hybrid_origin_, hybrid_request_id_));
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnCableEvent(
+    device::cablev2::Event event) {
+  if (pending_hybrid_qr_.empty()) {
+    return;
+  }
+  switch (event) {
+    case device::cablev2::Event::kPhoneConnected:
+      EmitHybridEvent("webauthn-hybrid-status", "phone-connected");
+      break;
+    case device::cablev2::Event::kBLEAdvertReceived:
+      EmitHybridEvent("webauthn-hybrid-status", "ble-advert-received");
+      break;
+    case device::cablev2::Event::kReady:
+      EmitHybridEvent("webauthn-hybrid-status", "ready");
+      break;
+  }
+}
+
 void ElectronAuthenticatorRequestClientDelegate::
     CancelPendingAccountSelection() {
   pending_responses_.clear();
   select_account_callback_.Reset();
+  ClearHybridState();
   if (cancel_callback_) {
     std::move(cancel_callback_).Run();
   }
