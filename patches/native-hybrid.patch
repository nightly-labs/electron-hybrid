+// Closed notifications are posted out of request teardown. A weak browser
+// context lets navigation still close the UI after the frame has disappeared.
+bool EmitHybridSessionEvent(base::WeakPtr<ElectronBrowserContext> context,
+                            content::GlobalRenderFrameHostId frame_id,
+                            const std::string& rp_id,
+                            const std::string& origin,
+                            const std::string& request_id,
+                            const std::string& event_name,
+                            const std::string& status,
+                            const std::string& qr,
+                            base::RepeatingClosure cancel) {
+  if (!context) {
+    return false;
+  }
+  auto* session = api::Session::FromBrowserContext(context.get());
+  if (!session || !session->Get()) {
+    return false;
+  }
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  gin::DataObjectBuilder details(isolate);
+  details.Set("requestId", request_id)
+      .Set("relyingPartyId", rp_id)
+      .Set("origin", origin)
+      .Set("status", status)
+      .Set("frame", content::RenderFrameHost::FromID(frame_id));
+  if (!qr.empty()) {
+    details.Set("qr", qr);
+  }
+  v8::Local<v8::Object> wrapper;
+  if (!session->Get()->GetWrapper(isolate).ToLocal(&wrapper)) {
+    return false;
+  }
+  auto event = gin_helper::internal::Event::New(isolate)
+                   ->GetWrapper(isolate)
+                   .ToLocalChecked();
+  v8::Local<v8::Value> result;
+  if (cancel) {
+    result = gin_helper::EmitEvent(isolate, wrapper, event_name, event,
+                                   details.Build(), std::move(cancel));
+  } else {
+    result = gin_helper::EmitEvent(isolate, wrapper, event_name, event,
+                                   details.Build());
+  }
+  bool had_listener = false;
+  return gin::ConvertFromV8(isolate, result, &had_listener) && had_listener;
+}
+
