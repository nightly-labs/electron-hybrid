+  ui_presentation_ = ui_presentation;
+}
+
+void ElectronAuthenticatorRequestClientDelegate::
+    OnTransportAvailabilityEnumerated(
+        device::FidoRequestHandlerBase::TransportAvailabilityInfo data) {
+  if (pending_hybrid_qr_.empty()) {
+    return;
+  }
+  if (!data.available_transports.contains(
+          device::FidoTransportProtocol::kHybrid)) {
+    ClearHybridState();
+    return;
+  }
+  auto weak_this = weak_factory_.GetWeakPtr();
+  const bool has_listener = EmitHybridEvent("webauthn-hybrid-qr", "qr");
+  if (!weak_this || pending_hybrid_qr_.empty()) {
+    return;
+  }
+  if (!has_listener) {
+    CancelPendingAccountSelection();
+    return;
+  }
+  // Request the macOS permission only once discovery has enumerated its
+  // adapter. Calling this earlier dereferences an uninitialized BLE manager.
+  if (data.ble_status == device::FidoRequestHandlerBase::BleStatus::
+                             kPendingPermissionRequest &&
+      request_ble_permission_callback_) {
+    EmitHybridEvent("webauthn-hybrid-status", "bluetooth-permission-requested");
+    if (!weak_this || pending_hybrid_qr_.empty()) {
+      return;
+    }
+    request_ble_permission_callback_.Run(
+        base::BindOnce(&ElectronAuthenticatorRequestClientDelegate::
+                           BluetoothAdapterStatusChanged,
+                       weak_factory_.GetWeakPtr()));
+    return;
+  }
+  BluetoothAdapterStatusChanged(data.ble_status);
+}
+
+void ElectronAuthenticatorRequestClientDelegate::BluetoothAdapterStatusChanged(
+    device::FidoRequestHandlerBase::BleStatus status) {
+  if (pending_hybrid_qr_.empty()) {
+    return;
+  }
+  using BleStatus = device::FidoRequestHandlerBase::BleStatus;
+  switch (status) {
+    case BleStatus::kOn:
+      EmitHybridEvent("webauthn-hybrid-status", "bluetooth-on");
+      break;
+    case BleStatus::kOff:
+      EmitHybridEvent("webauthn-hybrid-status", "bluetooth-off");
+      break;
+    case BleStatus::kPermissionDenied:
+      EmitHybridEvent("webauthn-hybrid-status", "bluetooth-permission-denied");
+      break;
+    case BleStatus::kPendingPermissionRequest:
+      break;
+  }
 }
 
